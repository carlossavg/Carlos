            },
            {
              "value": "scissors",
              "label": "Tijeras (ajustable)"
            },
            {
              "value": "clock",
              "label": "Reloj"
            },
            {
              "value": "calendar",
              "label": "Calendario"
            },
            {
              "value": "refresh",
              "label": "Renovar"
            },
            {
              "value": "truck",
              "label": "Camión"
            },
            {
              "value": "lock",
              "label": "Candado"
            },
            {
              "value": "return",
              "label": "Devolución"
            },
            {
              "value": "heart",
              "label": "Corazón"
            },
            {
              "value": "paw",
              "label": "Huella"
            },
            {
              "value": "sparkle",
              "label": "Destello"
            },
            {
              "value": "moon",
              "label": "Luna"
            },
            {
              "value": "sun",
              "label": "Sol"
            },
            {
              "value": "wind",
              "label": "Aroma"
            },
            {
              "value": "smile",
              "label": "Sonrisa"
            },
            {
              "value": "ruler",
              "label": "Regla (talla)"
            },
            {
              "value": "home",
              "label": "Casa"
            },
            {
              "value": "gift",
              "label": "Regalo"
            },
            {
              "value": "percent",
              "label": "Porcentaje"
            },
            {
              "value": "box",
              "label": "Caja"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "bolt",
              "label": "Rayo"
