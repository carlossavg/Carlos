{%- render 'pw-section-style' -%}
<section class="pw pw-on-{{ section.settings.bg }}">
  <div class="pw-container pw-container--narrow">
    <ul class="pw-trust" style="--pw-cols: 3">
      {%- for block in section.blocks -%}
        <li class="pw-trust__item" {{ block.shopify_attributes }}>
          <span class="pw-trust__icon">{% render 'pw-icon', icon: block.settings.icon %}</span>
          <span>{% render 'pw-t', t: block.settings.text %}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Pawlio · Sellos carrito",
  "tag": "div",
  "class": "pw-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Fondo",
      "options": [
        {
          "value": "cream",
          "label": "Crema"
        },
        {
          "value": "white",
          "label": "Blanco"
        },
        {
          "value": "sand",
          "label": "Arena"
        },
        {
          "value": "mint",
          "label": "Menta"
        },
        {
          "value": "forest",
          "label": "Verde bosque (oscuro)"
        }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "check-circle",
