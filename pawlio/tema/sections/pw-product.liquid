        { "value": "return", "label": "Devolución" }, { "value": "refresh", "label": "Renovar" }, { "value": "leaf", "label": "Hoja" },
        { "value": "chat", "label": "Chat" }, { "value": "gift", "label": "Regalo" }, { "value": "clock", "label": "Reloj" }
      ],
      "default": "shield-check"
    },
    { "type": "text", "id": "assurance_2", "label": "Texto 2", "default": "[days]-day money-back guarantee" },
    {
      "type": "select", "id": "assurance_3_icon", "label": "Icono 3",
      "options": [
        { "value": "truck", "label": "Camión" }, { "value": "shield-check", "label": "Escudo" }, { "value": "lock", "label": "Candado" },
        { "value": "return", "label": "Devolución" }, { "value": "refresh", "label": "Renovar" }, { "value": "leaf", "label": "Hoja" },
        { "value": "chat", "label": "Chat" }, { "value": "gift", "label": "Regalo" }, { "value": "clock", "label": "Reloj" }
      ],
      "default": "lock"
    },
    { "type": "text", "id": "assurance_3", "label": "Texto 3", "default": "Secure checkout" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar logos de métodos de pago", "default": true },
