    { "type": "header", "content": "Galería" },
    { "type": "select", "id": "media_position", "label": "Posición de las fotos (escritorio)", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "right", "label": "Derecha" } ], "default": "left" },
    { "type": "select", "id": "media_ratio", "label": "Forma de las fotos", "options": [ { "value": "square", "label": "Cuadrada" }, { "value": "portrait", "label": "Vertical (4:5)" }, { "value": "landscape", "label": "Horizontal (4:3)" } ], "default": "square" },
    { "type": "select", "id": "media_fit", "label": "Ajuste de la foto", "options": [ { "value": "cover", "label": "Llenar el cuadro" }, { "value": "contain", "label": "Mostrar la foto completa" } ], "default": "cover" },
    { "type": "text", "id": "media_badge", "label": "Etiqueta sobre la foto", "default": "Plant-powered" },
