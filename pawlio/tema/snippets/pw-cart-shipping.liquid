{%- comment -%}
  Pawlio · barra de envío gratis del carrito.
  El monto se cambia en Configuración del tema → Pawlio · Carrito.
  OJO: el envío gratis real se configura en Shopify → Configuración → Envíos (mismo monto).
{%- endcomment -%}
{%- liquid
  assign pw_threshold = settings.pw_free_shipping_threshold | default: 0 | times: 100 | round
  assign pw_total = cart.total_price
-%}
{%- if pw_threshold > 0 and cart.item_count > 0 -%}
  {%- assign pw_remaining = pw_threshold | minus: pw_total -%}
  {%- if pw_remaining > 0 -%}
    {%- liquid
      assign pw_pct = pw_total | times: 100 | divided_by: pw_threshold
      capture pw_amount
        echo '<strong>' | append: pw_remaining | money | append: '</strong>'
      endcapture
    -%}
    <div class="pw-ship" style="--pw-progress: {{ pw_pct }}%">
      <p class="pw-ship__msg">{% render 'pw-icon', icon: 'truck', size: 20 %}<span>{{ settings.pw_ship_progress | replace: '[amount]', pw_amount }}</span></p>
      <div class="pw-ship__bar" aria-hidden="true"><span class="pw-ship__fill"></span></div>
    </div>
  {%- else -%}
    <div class="pw-ship pw-ship--done">
      <p class="pw-ship__msg">{% render 'pw-icon', icon: 'check-circle', size: 20 %}<span>{{ settings.pw_ship_success }}</span></p>
      <div class="pw-ship__bar" aria-hidden="true"><span class="pw-ship__fill"></span></div>
    </div>
  {%- endif -%}
{%- endif -%}
