        {%- when 'clock' -%}<circle cx="12" cy="12" r="9.2"/><path d="M12 7.2V12l3.2 2"/>
        {%- when 'scissors' -%}<circle cx="6.2" cy="6.8" r="2.6"/><circle cx="6.2" cy="17.2" r="2.6"/><path d="M8.4 8.2 20 18M8.4 15.8 20 6"/>
