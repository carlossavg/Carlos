        {%- when 'arrow-down' -%}<path d="M12 4.5v15M6 13.5l6 6 6-6"/>
        {%- when 'gift' -%}<rect x="3.6" y="9.2" width="16.8" height="11.2" rx="1.6"/><path d="M2.6 9.2h18.8M12 9.2v11.2"/><path d="M12 9.2C10.6 5.8 6.8 5 6.8 7.4S10 9.2 12 9.2zm0 0c1.4-3.4 5.2-4.2 5.2-1.8S14 9.2 12 9.2z"/>
        {%- when 'percent' -%}<path d="M18.5 5.5l-13 13"/><circle cx="7.2" cy="7.2" r="2.4"/><circle cx="16.8" cy="16.8" r="2.4"/>
        {%- when 'box' -%}<path d="M3.6 7.6 12 3.2l8.4 4.4v8.8L12 20.8l-8.4-4.4z"/><path d="M3.6 7.6 12 12l8.4-4.4M12 12v8.8"/>
        {%- when 'return' -%}<path d="M9.2 14.2 4.4 9.4l4.8-4.8"/><path d="M4.4 9.4h10.4a5.4 5.4 0 0 1 0 10.8h-3.4"/>
        {%- when 'smile' -%}<circle cx="12" cy="12" r="9.2"/><path d="M8.4 14.2a4.6 4.6 0 0 0 7.2 0M9 9.6h.01M15 9.6h.01"/>
        {%- when 'wind' -%}<path d="M3 8.2h11a3 3 0 1 0-3-3"/><path d="M3 12h15.2a3 3 0 1 1-3 3"/><path d="M3 15.8h7"/>
        {%- when 'ruler' -%}<rect x="2.6" y="7.8" width="18.8" height="8.4" rx="1.6"/><path d="M6.6 7.8v3M10.4 7.8v4.2M14.2 7.8v3M18 7.8v4.2"/>
        {%- when 'home' -%}<path d="M3.2 11.2 12 4l8.8 7.2"/><path d="M5.6 9.6v10.6h12.8V9.6"/><path d="M10 20.2v-5.4h4v5.4"/>
        {%- when 'bolt' -%}<path d="M13.2 2.8 4.6 13.6h6.6l-1 7.6 8.6-10.8h-6.6z"/>
        {%- when 'pin' -%}<path d="M12 21.2s-7-6.2-7-11.6a7 7 0 0 1 14 0c0 5.4-7 11.6-7 11.6z"/><circle cx="12" cy="9.6" r="2.5"/>
        {%- when 'mail' -%}<rect x="3.2" y="5.2" width="17.6" height="13.6" rx="2.2"/><path d="m3.8 6.6 8.2 6.2 8.2-6.2"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}<path d="M5 12h14"/>
        {%- when 'chevron-down' -%}<path d="m6 9.2 6 6 6-6"/>
        {%- when 'tag' -%}<path d="M3.4 12.6V4.2a.8.8 0 0 1 .8-.8h8.4l8.2 8.2a1.2 1.2 0 0 1 0 1.7l-6.9 6.9a1.2 1.2 0 0 1-1.7 0z"/><circle cx="8" cy="8" r="1.4"/>
        {%- when 'users' -%}<circle cx="9" cy="8.4" r="3.4"/><path d="M2.8 20c.5-3.4 3-5.6 6.2-5.6s5.7 2.2 6.2 5.6"/><path d="M16 5.2a3.2 3.2 0 0 1 0 6.2M18 14.6c1.8.7 3 2.6 3.2 5.2"/>
        {%- when 'thermometer' -%}<path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0z"/>
        {%- when 'bug' -%}<ellipse cx="12" cy="13.6" rx="4.4" ry="5.6"/><path d="M12 8V5.4M9.6 6.2 8 4.4M14.4 6.2 16 4.4M7.6 11.2H4.4M7.6 15.2H4.6M16.4 11.2h3.2M16.4 15.2h3"/>
        {%- else -%}<circle cx="12" cy="12" r="9.2"/><path d="m8.2 12.4 2.6 2.6 5-5.4"/>
      {%- endcase -%}
