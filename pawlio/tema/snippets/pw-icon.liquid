        {%- when 'heart' -%}<path d="M12 20.2s-7.6-4.6-7.6-10.4A4.3 4.3 0 0 1 12 7.1a4.3 4.3 0 0 1 7.6 2.7c0 5.8-7.6 10.4-7.6 10.4z"/>
        {%- when 'paw' -%}<ellipse cx="5.8" cy="10.3" rx="1.9" ry="2.4" transform="rotate(-18 5.8 10.3)"/><ellipse cx="9.5" cy="6.1" rx="1.9" ry="2.5" transform="rotate(-6 9.5 6.1)"/><ellipse cx="14.5" cy="6.1" rx="1.9" ry="2.5" transform="rotate(6 14.5 6.1)"/><ellipse cx="18.2" cy="10.3" rx="1.9" ry="2.4" transform="rotate(18 18.2 10.3)"/><path d="M12 11.6c-2.7 0-5.8 3.8-5.8 6.2 0 1.7 1.3 2.7 2.9 2.7 1.1 0 1.9-.6 2.9-.6s1.8.6 2.9.6c1.6 0 2.9-1 2.9-2.7 0-2.4-3.1-6.2-5.8-6.2z"/>
