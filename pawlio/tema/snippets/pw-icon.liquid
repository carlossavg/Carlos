{%- comment -%}
  Pawlio · iconos SVG en línea.
  Uso: {% render 'pw-icon', icon: 'leaf' %}  ·  opcional: px: 24, class: 'x'
{%- endcomment -%}
{%- liquid
  assign pw_size = px | default: 24
  assign pw_stroke = stroke | default: 1.8
-%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="pw-icon pw-icon--star {{ class }}" width="{{ pw_size }}" height="{{ pw_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"/></svg>
  {%- when 'paw-solid' -%}
    <svg class="pw-icon {{ class }}" width="{{ pw_size }}" height="{{ pw_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="5.6" cy="10.2" rx="2.1" ry="2.6" transform="rotate(-18 5.6 10.2)"/><ellipse cx="9.4" cy="5.9" rx="2.1" ry="2.7" transform="rotate(-6 9.4 5.9)"/><ellipse cx="14.6" cy="5.9" rx="2.1" ry="2.7" transform="rotate(6 14.6 5.9)"/><ellipse cx="18.4" cy="10.2" rx="2.1" ry="2.6" transform="rotate(18 18.4 10.2)"/><path d="M12 11.2c-2.9 0-6.2 4-6.2 6.6 0 1.8 1.4 2.9 3.1 2.9 1.2 0 2-.6 3.1-.6s1.9.6 3.1.6c1.7 0 3.1-1.1 3.1-2.9 0-2.6-3.3-6.6-6.2-6.6z"/></svg>
  {%- else -%}
    <svg class="pw-icon {{ class }}" width="{{ pw_size }}" height="{{ pw_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ pw_stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {%- case icon -%}
        {%- when 'check' -%}<path d="M20 6.5 9.5 17 4 11.5"/>
        {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9.2"/><path d="m8.2 12.4 2.6 2.6 5-5.4"/>
        {%- when 'x' -%}<path d="M17.5 6.5l-11 11M6.5 6.5l11 11"/>
        {%- when 'x-circle' -%}<circle cx="12" cy="12" r="9.2"/><path d="m9 9 6 6M15 9l-6 6"/>
        {%- when 'leaf' -%}<path d="M5 19.5c-.3-8.3 4.8-13.6 14.5-14.6.4 9.6-4.9 14.8-13.4 14.8"/><path d="M5 19.5c2.8-4.6 5.9-7.6 9.5-9.6"/>
        {%- when 'drop' -%}<path d="M12 3.2s6.2 6.6 6.2 11.2a6.2 6.2 0 0 1-12.4 0C5.8 9.8 12 3.2 12 3.2z"/><path d="M9.3 14.6a2.8 2.8 0 0 0 2.4 2.6"/>
        {%- when 'shield' -%}<path d="M12 3 4.8 5.9v5.7c0 4.5 3 8.3 7.2 9.4 4.2-1.1 7.2-4.9 7.2-9.4V5.9z"/>
        {%- when 'shield-check' -%}<path d="M12 3 4.8 5.9v5.7c0 4.5 3 8.3 7.2 9.4 4.2-1.1 7.2-4.9 7.2-9.4V5.9z"/><path d="m8.9 12.1 2.2 2.2 4.1-4.3"/>
        {%- when 'truck' -%}<path d="M2.8 6.2h11.4v9.9H2.8z"/><path d="M14.2 9.2h3.9l3.1 3.3v3.6h-7"/><circle cx="7" cy="17.6" r="1.9"/><circle cx="17.3" cy="17.6" r="1.9"/>
        {%- when 'lock' -%}<rect x="4.8" y="10.4" width="14.4" height="10.2" rx="2.6"/><path d="M8.2 10.4V8a3.8 3.8 0 0 1 7.6 0v2.4"/><path d="M12 14.3v2.4"/>
        {%- when 'refresh' -%}<path d="M20 11.2A8 8 0 0 0 6.2 6.1L4.2 8"/><path d="M4.2 4v4h4"/><path d="M4 12.8a8 8 0 0 0 13.8 5.1l2-1.9"/><path d="M19.8 20v-4h-4"/>
