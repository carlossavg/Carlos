{%- comment -%}
  Pawlio · a dónde lleva un botón.
  - link: enlace elegido en el editor. Si está vacío:
    en la página del producto baja a la caja de compra (#pw-buy);
    en otras páginas (o con star: true) lleva al producto estrella.
{%- endcomment -%}
{%- liquid
  if link != blank
    echo link
  elsif template.name == 'product' and star != true
    echo '#pw-buy'
  else
    capture pw_star_handle
      render 'pw-star-handle'
    endcapture
    assign pw_star_handle = pw_star_handle | strip
    assign pw_fp = all_products[pw_star_handle]
    if pw_fp != blank
      echo pw_fp.url
    else
      echo routes.all_products_collection_url
    endif
  endif
-%}
